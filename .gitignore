# ---------------------------------------------------------------------------
# Intel Quartus Prime project .gitignore
# Keep only source (.v) and project (.qpf/.qsf) files under version control.
# Everything below is generated by Quartus and can be rebuilt from the sources.
# ---------------------------------------------------------------------------

# Quartus compilation output
db/
incremental_db/
output_files/
greybox_tmp/
hps_isw_handoff/
simulation/
synopsys/

# Quartus generated files
*.qws
*.rpt
*.summary
*.smsg
*.pin
*.jdi
*.done
*.qarlog
*.qdf
*.pof
*.sof
*.rbf
*.jic
*.ekp
*.txt

# Timing/fitting reports
*.sta.rpt
*.fit.rpt
*.map.rpt
*.asm.rpt
*.tan.rpt

# ModelSim / QuestaSim
transcript
vsim.wlf
work/
modelsim.ini
*.vcd
*.wlf

# Backup files
*.qsf.bak
*.qpf.bak
*.bak


